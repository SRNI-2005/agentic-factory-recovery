{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "implementer": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash"
    },
    "reviewer": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.3-flash",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--browser", "chromium"],
      "enabled": false,
      "environment": {}
    }
  }
}
