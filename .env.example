DATABASE_URL=postgresql+psycopg://coe:coe@localhost:5432/coe
MQTT_HOST=localhost
MQTT_PORT=1883
DEFAULT_SEED=42
TELEMETRY_CHUNK_INTERVAL_MINUTES=10080

# --- Phase 3: agentic middleware (spec section 9) ---
# Required for recover/benchmark live runs; fail fast if unset.
LLM_PROVIDER=gemini            # openai | gemini
LLM_MODEL=gemini-3-flash       # e.g. gemini-3-flash, gemini-3.5-flash, gpt-4o-mini
LLM_TEMPERATURE=0              # reproducibility default (spec: 0)
STRATEGY_MAX_ROUNDS=3
LLM_MAX_RETRIES=2
BENCHMARK_TRANSLATION_ACCURACY=0.90
RECOVERY_LOCK_WAIT_SECONDS=600

# Google AI (Gemini Developer API) key — get one at https://aistudio.google.com/apikey
# Read by langchain-google-genai from the environment; also export it in your shell:
#   set -a; source .env; set +a
GOOGLE_API_KEY=

